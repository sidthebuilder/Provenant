# Copy to .env and fill in. .env is git-ignored.
FALKORDB_HOST=localhost
FALKORDB_PORT=6379

# Path to a clone of github.com/sidthebuilder/swarmchaser (reused loader and key extractors)
SWARMCHASER_PATH=../swarmchaser

# Folder holding the AI Village *.jsonl.gz tables (Tracks 2 and 3)
VILLAGE_DATA=../data

# Optional: OpenAI-compatible endpoint for the LLM agent mode (scripts/ask_llm.py,
# or /api/ask with {"mode": "llm"}). The deterministic planner stays the default
# unless PROVENANT_AGENT_MODE=llm. Local example with Ollama:
#   LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=qwen2.5:7b  LLM_API_KEY=ollama
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
PROVENANT_AGENT_MODE=planner
